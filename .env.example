PORT=8787
CERVEL_RUNTIME_MODE=development
CERVEL_ENVIRONMENT_ID=local
CERVEL_PUBLIC_BASE_URL=http://localhost:8787
DATABASE_URL=postgresql://cervel:cervel@localhost:5432/cervel
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cervel
S3_ACCESS_KEY_ID=cervel
S3_SECRET_ACCESS_KEY=change-me-now
CERVEL_NODE_AUTHORITY=local
CERVEL_NODE_NAME=CERVEL Local Node
CERVEL_BOOTSTRAP_ADMIN_SUBJECT=local-admin
CERVEL_ALLOW_ALPHA_LOGIN=false
CERVEL_TRUST_PRINCIPAL_HEADER=false

# Knowledge automation
CERVEL_CONNECTOR_TOKEN_KEY=replace-with-secret-key-material
CERVEL_AUTOMATION_KEY=replace-with-internal-scheduler-secret
CERVEL_CONNECTOR_MAX_BYTES=26214400
CERVEL_CKEP_DRAIN_LIMIT=50

# Managed staging/production must set a unique environment ID and HTTPS public base URL.
# Google Drive OAuth
CERVEL_GOOGLE_DRIVE_CLIENT_ID=
CERVEL_GOOGLE_DRIVE_CLIENT_SECRET=
CERVEL_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8787/v1/connectors/google_drive/callback

# Dropbox OAuth
CERVEL_DROPBOX_CLIENT_ID=
CERVEL_DROPBOX_CLIENT_SECRET=
CERVEL_DROPBOX_REDIRECT_URI=http://localhost:8787/v1/connectors/dropbox/callback

# Microsoft OneDrive OAuth
CERVEL_ONEDRIVE_CLIENT_ID=
CERVEL_ONEDRIVE_CLIENT_SECRET=
CERVEL_ONEDRIVE_REDIRECT_URI=http://localhost:8787/v1/connectors/onedrive/callback
