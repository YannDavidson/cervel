{
  "manifest_version": 3,
  "name": "CERVEL Capture",
  "version": "0.1.0",
  "description": "Capture evidence and provenance into a user-owned CERVEL Vault.",
  "permissions": ["activeTab", "alarms", "contextMenus", "storage", "nativeMessaging", "scripting"],
  "host_permissions": [],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Capture to CERVEL" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
