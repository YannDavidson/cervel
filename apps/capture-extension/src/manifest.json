{
  "manifest_version": 3,
  "name": "CERVEL Capture",
  "version": "0.2.0",
  "description": "Capture pages, selections, links, PDFs, and notes into your paired CERVEL Vault.",
  "minimum_chrome_version": "121",
  "permissions": ["activeTab", "alarms", "contextMenus", "storage", "nativeMessaging", "scripting"],
  "host_permissions": [],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Add to CERVEL" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
