{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cervel.tech/schemas/ckep/v0.1",
  "title": "CERVEL Knowledge Event Protocol v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ckep","event","scope","subject","temporal","epistemics","provenance","integrity"],
  "properties": {
    "ckep": {"const":"0.1"},
    "event": {"type":"object","additionalProperties":false,"required":["id","type"],"properties":{"id":{"type":"string","pattern":"^cke://[^/]+/workspaces/[^/]+/events/[^/]+$"},"type":{"type":"string","enum":["OBJECT_CREATED","OBJECT_UPDATED","OBJECT_DELETED","ARTIFACT_VERSIONED","CLAIM_INTRODUCED","CLAIM_CONFIRMED","CLAIM_ASSERTED","CLAIM_MODIFIED","CLAIM_CONTRADICTED","CLAIM_CHALLENGED","CLAIM_SUPERSEDED","CLAIM_WITHDRAWN","CLAIM_RETRACTED","CONTRADICTION_DETECTED","CONTRADICTION_RESOLVED","RELATIONSHIP_CREATED","RELATIONSHIP_REMOVED","DECISION_CREATED","DECISION_CHANGED","DEADLINE_CHANGED","ENTITY_ADDED","SOURCE_CONNECTED","SOURCE_CHANGED","SOURCE_DELETED","SOURCE_STALE","SOURCE_RECOVERED","KNOWLEDGE_BECAME_STALE","KNOWLEDGE_HEALTH_DEGRADED","KNOWLEDGE_HEALTH_RECOVERED","RISK_DETECTED"]}}},
    "scope": {"type":"object","additionalProperties":false,"required":["node","workspace"],"properties":{"node":{"$ref":"#/$defs/ckUri"},"workspace":{"$ref":"#/$defs/ckUri"}}},
    "subject": {"$ref":"#/$defs/resourceRef"},
    "transition": {"type":"object","additionalProperties":false,"properties":{"previous":{"anyOf":[{"$ref":"#/$defs/stateRef"},{"type":"null"}]},"current":{"anyOf":[{"$ref":"#/$defs/stateRef"},{"type":"null"}]}}},
    "temporal": {"type":"object","additionalProperties":false,"required":["observed_at"],"properties":{"observed_at":{"type":"string","format":"date-time"},"effective_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]}}},
    "evidence": {"type":"object","additionalProperties":false,"properties":{"sources":{"type":"array","items":{"$ref":"#/$defs/ckUri"}},"artifact":{"$ref":"#/$defs/ckUri"},"artifact_version":{"type":"integer","minimum":1},"fragments":{"type":"array","items":{"$ref":"#/$defs/ckUri"}}}},
    "epistemics": {"type":"object","additionalProperties":false,"required":["confidence"],"properties":{"confidence":{"type":"number","minimum":0,"maximum":1},"status":{"type":"string","minLength":1}}},
    "impact": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["uri"],"properties":{"uri":{"$ref":"#/$defs/ckUri"},"relationship":{"type":"string"},"severity":{"enum":["info","low","medium","high","critical"]},"confidence":{"type":"number","minimum":0,"maximum":1}}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["method"],"properties":{"actor":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"type":"string"},"uri":{"$ref":"#/$defs/ckUri"}}},"method":{"type":"string","minLength":1},"derived_from":{"type":"array","items":{"$ref":"#/$defs/ckUri"}},"artifact":{"$ref":"#/$defs/ckUri"},"artifact_version":{"type":"integer","minimum":1},"fragments":{"type":"array","items":{"$ref":"#/$defs/ckUri"}},"metadata":{"type":"object"}}},
    "causality": {"type":"object","additionalProperties":false,"properties":{"caused_by":{"type":"array","items":{"$ref":"#/$defs/ckeUri"}},"correlation_id":{"type":"string","minLength":1},"root_event":{"$ref":"#/$defs/ckeUri"}}},
    "integrity": {"type":"object","additionalProperties":false,"required":["sequence","idempotency_key","hash"],"properties":{"sequence":{"type":"integer","minimum":1},"previous_event":{"anyOf":[{"$ref":"#/$defs/ckeUri"},{"type":"null"}]},"idempotency_key":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"hash":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}}},
    "extensions": {"type":"object"}
  },
  "$defs": {
    "ckUri": {"type":"string","pattern":"^ck://[^/]+/.+$"},
    "ckeUri": {"type":"string","pattern":"^cke://[^/]+/workspaces/[^/]+/events/[^/]+$"},
    "resourceRef": {"type":"object","additionalProperties":false,"required":["uri","type"],"properties":{"uri":{"$ref":"#/$defs/ckUri"},"type":{"type":"string","minLength":1}}},
    "stateRef": {"type":"object","additionalProperties":false,"anyOf":[{"required":["uri"]},{"required":["value"]}],"properties":{"uri":{"$ref":"#/$defs/ckUri"},"value":{},"version":{"type":"integer","minimum":1}}}
  }
}
